@baseUrl = http://127.0.0.1:9000
@userName = api-test-user
@exercise = squat

### 0) 프로필 생성 (이미 있으면 생략 가능)
# @name createProfile
POST {{baseUrl}}/api/users/profiles
Content-Type: application/json

{
  "name": "{{userName}}"
}

### 1) 세션 시작 (운동을 실제로 안 해도 시작 가능)
# createProfile 응답에서 id를 가져와 자동 연결
@userId = {{createProfile.response.body.$.id}}

# @name startSession
POST {{baseUrl}}/api/sessions/start
Content-Type: application/json

{
  "user_id": "{{userId}}",
  "mode": "exercise",
  "goal": "{{exercise}}"
}

### 2-A) 세션 종료 (운동 안 하고 바로 종료 테스트)
@sessionId = {{startSession.response.body.$.session_id}}

# @name stopSession
POST {{baseUrl}}/api/sessions/{{sessionId}}/stop

### 2-B) 세션 스킵 테스트 (위 stop 대신 이 요청 사용)
# @name skipSession
POST {{baseUrl}}/api/sessions/{{sessionId}}/skip
Content-Type: application/json

{
  "reason": "manual_test_skip"
}

### 3) 저장된 세션 결과 재조회
# @name getSessionResult
GET {{baseUrl}}/api/sessions/{{sessionId}}/result

### 4) 사용자 진행 요약 조회
# @name getProgress
GET {{baseUrl}}/api/users/{{userId}}/progress?days=30

### 5) 코칭 로그 조회
# @name getCoachLogs
GET {{baseUrl}}/api/coach/logs/{{userId}}?limit=5

### 사용 순서
# 1. createProfile 실행
# 2. startSession 실행
# 3. stopSession 또는 skipSession 중 하나 실행
# 4. getSessionResult 실행
# 5. 필요하면 getProgress/getCoachLogs 실행
#
# 팁:
# - 기존 유저를 쓰고 싶으면 @userId를 직접 문자열로 바꿔도 됩니다.
# - goal은 squat, pushup, lunge, knee_raise, jumping_jack 중 하나를 쓰세요.
